{
    "Version": "2012-10-17",
    "Statement": [
        {
            "Sid": "NoReadExceptForClean",
            "Effect": "Deny",
            "NotPrincipal": {
                "AWS": [
                    "arn:aws:iam::AWS_ACCOUNT:role/GUARDDUTY_ROLE_NAME",
                    "arn:aws:iam::AWS_ACCOUNT:root",
                    "arn:aws:sts::AWS_ACCOUNT:assumed-role/GUARDDUTY_ROLE_NAME/GuardDutyMalwareProtection"
                ]
            },
            "Action": [
                "s3:GetObject",
                "s3:GetObjectVersion"
            ],
            "Resource": [
                "BUCKET_ARN",
                "BUCKET_ARN/*"
            ],
            "Condition": {
                "ForAllValues:StringNotEquals": {
                    "s3:ExistingObjectTag/GuardDutyMalwareScanStatus": [
                        "NO_THREATS_FOUND",
                        "UNSUPPORTED"
                    ]
                }
            }
        },
        {
            "Sid": "OnlyGuardDutyCanTag",
            "Effect": "Deny",
            "NotPrincipal": {
                "AWS": [
                    "arn:aws:iam::AWS_ACCOUNT:role/GUARDDUTY_ROLE_NAME",
                    "arn:aws:iam::AWS_ACCOUNT:root",
                    "arn:aws:sts::AWS_ACCOUNT:assumed-role/GUARDDUTY_ROLE_NAME/GuardDutyMalwareProtection"
                ]
            },
            "Action": "s3:PutObjectTagging",
            "Resource": [
                "BUCKET_ARN",
                "BUCKET_ARN/*"
            ]
        }
    ]
}