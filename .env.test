# Domain
# This would be set to the production domain with an env var on deployment
DOMAIN=localhost

# Environment: local, staging, production
ENVIRONMENT=local

PROJECT_NAME='Driver AI App'
STACK_NAME=driver-ai-app

# Backend
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,https://localhost,https://localhost:5173,http://localhost:3000"
USERS_OPEN_REGISTRATION=False

# Emails
SMTP_HOST=changethis
SMTP_USER=changethis
SMTP_PASSWORD=changethis
EMAILS_FROM_EMAIL=support@driverai.com
SMTP_TLS=True
SMTP_SSL=False
SMTP_PORT=587

# Postgres
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=local_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changethis

# Configure these with your own Docker registry images
DOCKER_IMAGE_BACKEND=backend
DOCKER_IMAGE_FRONTEND=frontend

# Auth0
AUTH0_DOMAIN=driverai-dev.us.auth0.com
AUTH0_CLIENT_ID=thisisfortesting
AUTH0_AUDIENCE=https://api.dev.driverai.com/api/v1

AUTH0_MGMT_API_CLIENT_ID=thisisfortesting
AUTH0_MGMT_API_CLIENT_SECRET=thisisfortesting
AUTH0_MGMT_API_AUDIENCE=https://driverai-dev.us.auth0.com/api/v2/

# AWS
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1

MODAL_TOKEN_ID=test
MODAL_TOKEN_SECRET=test
MODAL_ENVIRONMENT=dev
